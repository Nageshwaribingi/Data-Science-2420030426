# string formatting method 
fname = "Nageshwari"
fage = 20
print(f"Hello, my name is {fname} and I am {fage} years old.")
txt1 = "My name is {fname} , I'm {age}".format(fname="John", age=30)
print(txt1)
txt2 = "My name is {0} , I'm {1}".format("Lisa", 10)
print(txt2)
txt3 = "My name is {} , I'm {}".format("Lisa", 10)
print(txt3)

