#iterative statements 
# for loop with range (start,finish,incerement/decrement)

for x in range (2):
    print(x)
    
for x in range (2,20,2):
    print(x)

for x in range (20,1,-3):
    print(x)
    
#multiplication table of 10 
for i in range (1,11):
    print(f"10 x {i} = {10*i}")

# print even numbers from 1 to 100 
for i in range (1,101):
    if i%2 == 0 :
        print(i)
        
# number is palindrome or not 
#prime or not 
for i in range (1,101):
    if i > 1:
        for j in range (2,i):
            if (i%j) == 0:
                break
        else:
            print(i)

