#def functions 
def find_square(n):
    return n*n

numd_to_square = input()
square = find_square(int(numd_to_square))
print(f"The square of {numd_to_square} is {square}")

def find_odd_even(n):
    if n%2 == 0:
        return "Even"
    else:
        return "Odd"
    
num_check = input("Enter number: ")
Even = find_odd_even(int(num_check))
print(f"The number {num_check} is {Even}")

